// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your own values.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
DEVELOPMENT_TEAM = ABCDE12345

// A bundle identifier you own.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.repod

// Spotify: enter your Client ID in the app's Settings (设置 → Spotify). It is stored
// on the device only, so it does not belong in this file.
